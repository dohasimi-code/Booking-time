# PostgreSQL connection string (Supabase, Neon, Railway or local Postgres)
DATABASE_URL=postgres://booking:booking@localhost:5432/booking
# SSL is on automatically for hosted databases; set "false" or "true" to override
# DATABASE_SSL=

# Secret code used once at /admin/setup to create Donald's login (8+ characters)
ADMIN_SETUP_CODE=

# Public base URL, used in email links (no trailing slash). On Vercel it defaults to the production URL.
APP_URL=http://localhost:3000

# Optional: email notifications via Resend (https://resend.com).
# Leave empty to keep emails switched off.
RESEND_API_KEY=
EMAIL_FROM="Booking Time with Donald <bookings@yourdomain.com>"
