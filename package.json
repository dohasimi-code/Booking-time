{
  "name": "booking-time-with-donald",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "admin:create": "tsx --env-file-if-exists=.env.local scripts/create-admin.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "typecheck": "tsc --noEmit",
    "data:purge": "tsx --env-file-if-exists=.env.local scripts/purge-old.ts",
    "test:e2e": "vitest run tests/e2e"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "luxon": "^3.7.2",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
